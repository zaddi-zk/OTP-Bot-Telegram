# ============================================================================
# TELEGRAM BOT CONFIGURATION
# ============================================================================
BOT_TOKEN=YOUR_BOT_TOKEN_HERE
USE_WEBHOOK=false
WEBHOOK_URL=https://your-domain.com
WEBHOOK_PATH=/telegram_webhook
TELEGRAM_API_BASE_URL=https://api.telegram.org/bot

# ============================================================================
# WEBHOOKS / PUBLIC URL
# ============================================================================
NGROK_URL=https://your-ngrok-url.ngrok-free.dev
NGROK_TOKEN=

# SMS Gateway (generic HTTP API)
SMS_PROVIDER=generic
SMS_API_URL=
SMS_API_KEY=

# ============================================================================
# TELEGRAM CHANNELS & ADMINS
# ============================================================================
MAIN_CHANNEL_URL=https://t.me/your_main_channel
BACKUP_CHANNEL_URL=https://t.me/your_backup_channel
MAIN_CHANNEL_ID=
BACKUP_CHANNEL_ID=
OWNER_ID=
ADMIN_ID=
DEVELOPER_IDS=

# ============================================================================
# VAPI CONFIGURATION (Conversation AI — handles ASR, LLM, TTS)
# ============================================================================
VAPI_API_KEY=YOUR_VAPI_API_KEY_HERE
VAPI_ASSISTANT_ID=your-vapi-assistant-id
VAPI_PHONE_NUMBER_ID=your-vapi-phone-number-id
VAPI_WEBHOOK_SECRET=
VAPI_MODEL=chat-latest

# ============================================================================
# ASTERISK OUTBOUND (Vapi SIP -> Asterisk -> SpoofGlobal trunk)
# ============================================================================
# All outbound dialing routes through Asterisk: Vapi places the call with the
# SIP phone number resource below, which INVITEs Asterisk; Asterisk reads the
# per-call <E.164>.json caller-ID file and dials the target through the
# SpoofGlobal trunk with the operator-provided CLI (caller ID is mandatory).
USE_ASTERISK=true
VAPI_SIP_PHONE_NUMBER_ID=your-vapi-sip-phone-number-id
ASTERISK_TRUNK=spoofglobal
ASTERISK_CLI_DIR=/var/spool/asterisk/cli
# Shared secret the Asterisk AGI presents when it pulls the per-call caller-ID
# JSON from the bot's /vapi/cli/<e164> endpoint (set the SAME value in the AGI
# runtime env on the Asterisk host, plus ASTERISK_CLI_PUBLIC_URL = bot base URL).
ASTERISK_CLI_API_TOKEN=generate-a-long-random-token
# Public base URL of the bot used by the AGI's HTTP pull (e.g. https://your-bot.onrender.com).
# Optional: when unset the AGI falls back to the local-file path (single host).
ASTERISK_CLI_PUBLIC_URL=
# ASTERISK_DEFAULT_CALLER_ID=OTP Bot <+12025550131>

# ============================================================================
# PAYMENT & TRIAL
# ============================================================================
PAYMENT_BTC=YOUR_WALLET_ADDRESS_HERE
PAYMENT_ETH=YOUR_WALLET_ADDRESS_HERE
PAYMENT_LTC=YOUR_WALLET_ADDRESS_HERE
PAYMENT_USDT=YOUR_WALLET_ADDRESS_HERE
FREE_TRIAL_CALLS=3


# ============================================================================
# EXTERNAL SERVICES
# ============================================================================
ABSTRACT_API_KEY=

# ============================================================================
# SERVER & DEPLOYMENT
# ============================================================================
PORT=5000
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
DEBUG=false

# Redis (optional, for rate limiting)
REDIS_URL=

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_REFILL_RATE=1.0
RATE_LIMIT_MAX_VIOLATIONS=5
RATE_LIMIT_BASE_BAN_DURATION=300
RATE_LIMIT_MAX_BAN_DURATION=86400
RATE_LIMIT_BAN_ESCALATION_FACTOR=2.0
