# ============================================================================
# TELEGRAM BOT CONFIGURATION
# ============================================================================
BOT_TOKEN=YOUR_BOT_TOKEN_HERE
USE_WEBHOOK=false
WEBHOOK_URL=https://your-domain.com
WEBHOOK_PATH=/telegram_webhook
TELEGRAM_API_BASE_URL=https://api.telegram.org/bot

# ============================================================================
# TWILIO CONFIGURATION (Voice Calls, SMS, OTP)
# ============================================================================
TWILIO_ACCOUNT_SID=YOUR_TWILIO_SID_HERE
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN_HERE
TWILIO_PHONE_NUMBER=+1234567890
NGROK_URL=https://your-ngrok-url.ngrok-free.dev
NGROK_TOKEN=

# ============================================================================
# ZOIPER / SIP INBOUND (receive calls on your own number via SIP)
# ============================================================================
# Target SIP URI for <Dial><Sip>. Must include the registered username so
# Twilio can route to the registered device (bare domain => instant failed leg).
ZOIPER_SIP_URL=sip:zaddi008@myzoiper008.sip.twilio.com

# ============================================================================
# TWILIO PROXY NUMBER POOL (concurrent multi-user calling)
# One number per concurrent call. Set PROXY_SERVICE_SID from scripts/setup_proxy.py.
# ============================================================================
PROXY_SERVICE_SID=KSxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PROXY_POOL_NUMBERS=+19852848980,+17623566007,+14247881997,+12405698072,+19897877518,+13073572084,+19129147157
PROXY_POOL_ENABLED=true
PROXY_LEASE_TTL_SECONDS=3600
PROXY_QUEUE_TTL_SECONDS=120
# PROXY_CALLBACK_URL=https://your-bot-webhook.com/proxy-events

# SMS Gateway (Twilio or Custom)
SMS_PROVIDER=twilio
SMS_API_URL=
SMS_API_KEY=

# ============================================================================
# TELEGRAM CHANNELS & ADMINS
# ============================================================================
MAIN_CHANNEL_URL=https://t.me/your_main_channel
BACKUP_CHANNEL_URL=https://t.me/your_backup_channel
MAIN_CHANNEL_ID=
BACKUP_CHANNEL_ID=
OWNER_ID=
ADMIN_ID=
DEVELOPER_IDS=

# ============================================================================
# VAPI CONFIGURATION (Conversation AI — handles ASR, LLM, TTS)
# ============================================================================
VAPI_API_KEY=YOUR_VAPI_API_KEY_HERE
VAPI_ASSISTANT_ID=your-vapi-assistant-id
# Optional: only used as a fallback if the inline ref is rejected. The live dialed
# pool number is preferred, so rotation shows in Vapi's dashboard automatically.
VAPI_PHONE_NUMBER_ID=your-vapi-phone-number-id
VAPI_WEBHOOK_SECRET=
VAPI_MODEL=chat-latest

# ============================================================================
# PAYMENT & TRIAL
# ============================================================================
PAYMENT_BTC=YOUR_WALLET_ADDRESS_HERE
PAYMENT_ETH=YOUR_WALLET_ADDRESS_HERE
PAYMENT_LTC=YOUR_WALLET_ADDRESS_HERE
PAYMENT_USDT=YOUR_WALLET_ADDRESS_HERE
FREE_TRIAL_CALLS=5


# ============================================================================
# EXTERNAL SERVICES
# ============================================================================
ABSTRACT_API_KEY=

# ============================================================================
# SERVER & DEPLOYMENT
# ============================================================================
PORT=5000
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
DEBUG=false

# Redis (optional, for rate limiting)
REDIS_URL=

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_REFILL_RATE=1.0
RATE_LIMIT_MAX_VIOLATIONS=5
RATE_LIMIT_BASE_BAN_DURATION=300
RATE_LIMIT_MAX_BAN_DURATION=86400
RATE_LIMIT_BAN_ESCALATION_FACTOR=2.0
